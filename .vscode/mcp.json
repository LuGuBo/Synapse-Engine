{
  "mcpServers": {
    "github-local": {
      "command": "${workspaceFolder}/bin/github-mcp-server.exe",
      "args": [
        "stdio",
        "--toolsets=all"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PAT}",
        "GITHUB_TOKEN": "${env:GITHUB_PAT}"
      },
      "description": "Servidor MCP GitHub oficial em Go com suporte total a releases, tags e 85+ ferramentas"
    }
  }
}